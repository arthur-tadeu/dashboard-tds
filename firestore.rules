rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write metas and tasks if authenticated
    match /metas/{metaId} {
      allow read, write: if request.auth != null;
    }
    
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Global settings: anyone authenticated can read, admins (authenticated) can write
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Simplified, in production check for admin flag
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}